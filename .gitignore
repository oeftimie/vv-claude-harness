# Claude Code local config (shared hooks and settings are committed)
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json

# Harness transient session state
.harness/SESSION_INCOMPLETE
.harness/features.json.lock
.harness/dashboard/
.harness/last_gate.json

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Dependencies
node_modules/
vendor/
# F091: hooks/dashboard/vendor/ is committed on purpose -- a vendored,
# no-CDN, no-build-step copy of animejs the dashboard frontend ships with.
!hooks/dashboard/vendor/
!hooks/dashboard/vendor/*
__pycache__/
*.pyc
.venv/
venv/

# Build outputs
dist/
build/
*.o
*.a
*.so

# Logs
*.log
logs/

# Test coverage
coverage/
.coverage
htmlcov/

# Temporary files
tmp/
temp/
*.tmp
